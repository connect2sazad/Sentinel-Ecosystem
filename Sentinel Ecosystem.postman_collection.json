{
  "info": {
    "_postman_id": "55f4d5f7-b9b4-43a1-9bb0-58facb9857a4",
    "name": "Sentinel Ecosystem",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "36203098"
  },
  "item": [
    {
      "name": "sentinel-auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();\r\n\r\nif (\r\n    pm.response.code === 200 &&\r\n    body?.success &&\r\n    body?.data?.access_token\r\n) {\r\n    const token = String(\r\n        body.data.access_token\r\n    ).trim();\r\n\r\n    pm.collectionVariables.set(\r\n        \"sentinel_access_token\",\r\n        token\r\n    );\r\n\r\n    console.log(\r\n        \"LOGIN STORED:\",\r\n        pm.collectionVariables.get(\r\n            \"sentinel_access_token\"\r\n        )?.length,\r\n        pm.collectionVariables\r\n            .get(\"sentinel_access_token\")\r\n            ?.split(\".\").length\r\n    );\r\n}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"login\": \"sazad@example.com\",\r\n    \"password\": \"Sentinel@123\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Me",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const token =\r\n    pm.collectionVariables.get(\r\n        \"sentinel_access_token\"\r\n    );\r\n\r\nconsole.log(\r\n    \"ME COLLECTION TOKEN:\",\r\n    token?.length,\r\n    token?.split(\".\").length\r\n);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{sentinel_access_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/auth/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"name\": \"Sazad Ahemad\",\r\n    \"email\": \"sazad@example.com\",\r\n    \"username\": \"sazad\",\r\n    \"password\": \"Sentinel@123\",\r\n    \"confirm_password\": \"Sentinel@123\",\r\n    \"organization_name\": \"Sentinel Technologies\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            }
          },
          "response": []
        }
      ]
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": ""
    },
    {
      "key": "sentinel_access_token",
      "value": ""
    }
  ]
}