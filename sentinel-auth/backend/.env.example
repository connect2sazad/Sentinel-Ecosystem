APP_NAME=Sentinel Auth
NODE_ENV=development

PORT=5000

FRONTEND_URL=http://localhost:5173

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sentinel_auth
DB_USER=root
DB_PASSWORD=

JWT_SECRET=sentinel-development-secret-change-this-later
JWT_EXPIRES_IN=15m

JWT_REFRESH_SECRET=sentinel-refresh-development-secret-change-this-later
JWT_REFRESH_EXPIRES_IN=7d

MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USERNAME=
MAIL_PASSWORD=

MAIL_FROM_NAME=Sentinel
MAIL_FROM_ADDRESS=no-reply@sentinel.local

PASSWORD_RESET_OTP_EXPIRES_MINUTES=10
PASSWORD_RESET_TOKEN_EXPIRES_MINUTES=10
PASSWORD_RESET_RESEND_COOLDOWN_SECONDS=60
PASSWORD_RESET_MAX_ATTEMPTS=5
MAIL_DEBUG=true

EMAIL_VERIFICATION_OTP_EXPIRES_MINUTES=10
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60